# LOCAL DEVELOPMENT ONLY. Copy to .env; never commit real credentials.
IOP_ENVIRONMENT=development
IOP_DATABASE_URL=postgresql+psycopg://operations:operations_dev@127.0.0.1:55432/operations
IOP_REDIS_URL=redis://127.0.0.1:56379/0
IOP_S3_ENDPOINT=http://127.0.0.1:59000
IOP_S3_ACCESS_KEY=operations_dev
IOP_S3_SECRET_KEY=operations_dev_secret
IOP_S3_BUCKET=operations-private
IOP_CORS_ORIGINS=["http://localhost:5173"]
