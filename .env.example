# LOCAL DEVELOPMENT ONLY. Copy to .env; never commit real credentials.
IOP_ENVIRONMENT=development
IOP_DATABASE_URL=postgresql+psycopg://operations:operations_dev@127.0.0.1:55432/operations
IOP_REDIS_URL=redis://127.0.0.1:56379/0
IOP_S3_ENDPOINT=http://127.0.0.1:59000
IOP_S3_ACCESS_KEY=operations_dev
IOP_S3_SECRET_KEY=operations_dev_secret
IOP_S3_BUCKET=operations-private
IOP_CORS_ORIGINS=["http://localhost:5173"]
# Optional OTLP HTTP trace endpoint, e.g. http://localhost:4318/v1/traces
# IOP_OTLP_ENDPOINT=
# Optional local PKCE provider: docker compose --profile oidc-dev up -d --wait
# IOP_OIDC_ISSUER=http://127.0.0.1:58080/realms/operations
# IOP_OIDC_JWKS_URL=http://127.0.0.1:58080/realms/operations/protocol/openid-connect/certs
# IOP_OIDC_AUDIENCE=operations-api
# IOP_OIDC_PROFILE=keycloak
# Production requires HTTPS and an explicitly configured provider.
# IOP_OIDC_MAX_TOKEN_LIFETIME=3600
# IOP_API_RATE_LIMIT=600
