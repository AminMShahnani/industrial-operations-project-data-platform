{
  "components": {
    "schemas": {
      "DependencyStatus": {
        "properties": {
          "database": {
            "enum": [
              "up",
              "down"
            ],
            "title": "Database",
            "type": "string"
          },
          "object_storage": {
            "enum": [
              "up",
              "down"
            ],
            "title": "Object Storage",
            "type": "string"
          },
          "redis": {
            "enum": [
              "up",
              "down"
            ],
            "title": "Redis",
            "type": "string"
          }
        },
        "required": [
          "database",
          "redis",
          "object_storage"
        ],
        "title": "DependencyStatus",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "dependencies": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DependencyStatus"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "ok",
              "ready",
              "unavailable"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "ProblemDetails": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "title",
          "status",
          "code",
          "request_id"
        ],
        "title": "ProblemDetails",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Industrial Operations Platform",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
