{
  "$defs": {
    "PackCapability": {
      "enum": [
        "fields",
        "components",
        "forms",
        "master-data",
        "workflows",
        "automations",
        "dashboards",
        "reports",
        "roles",
        "integrations",
        "import-mappings",
        "locales"
      ],
      "title": "PackCapability",
      "type": "string"
    },
    "PackContentChecksum": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "maxLength": 240,
          "minLength": 1,
          "pattern": "^(?:[A-Za-z0-9_-][A-Za-z0-9._-]*/)*[A-Za-z0-9_-][A-Za-z0-9._-]*\\.(csv|json|md|txt|yaml|yml)$",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "PackContentChecksum",
      "type": "object"
    },
    "PackDependency": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 180,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "version_range": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[<>=!~^0-9A-Za-z.+,* -]+$",
          "title": "Version Range",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version_range"
      ],
      "title": "PackDependency",
      "type": "object"
    },
    "PackType": {
      "enum": [
        "industry",
        "functional",
        "organization_overlay"
      ],
      "title": "PackType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "capabilities": {
      "items": {
        "$ref": "#/$defs/PackCapability"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Capabilities",
      "type": "array"
    },
    "content_checksums": {
      "items": {
        "$ref": "#/$defs/PackContentChecksum"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Content Checksums",
      "type": "array"
    },
    "core_version_range": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[<>=!~^0-9A-Za-z.+,* -]+$",
      "title": "Core Version Range",
      "type": "string"
    },
    "dependencies": {
      "items": {
        "$ref": "#/$defs/PackDependency"
      },
      "maxItems": 64,
      "title": "Dependencies",
      "type": "array"
    },
    "id": {
      "maxLength": 180,
      "minLength": 3,
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "title": "Id",
      "type": "string"
    },
    "name": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "pack_type": {
      "$ref": "#/$defs/PackType"
    },
    "publisher": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Publisher",
      "type": "string"
    },
    "schema_version": {
      "pattern": "^1$",
      "title": "Schema Version",
      "type": "string"
    },
    "version": {
      "maxLength": 128,
      "minLength": 5,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "name",
    "version",
    "pack_type",
    "core_version_range",
    "capabilities",
    "content_checksums",
    "publisher"
  ],
  "title": "PackManifest",
  "type": "object"
}
